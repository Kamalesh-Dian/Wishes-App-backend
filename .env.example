# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
DEFAULT_TZ=Asia/Kolkata
LOG_LEVEL=info # (info, debug, warn, error, fatal)

# Database
MONGO_URI=mongodb://localhost:27017/wishes_ai

# Security & Admin Access
JWT_SECRET=your_jwt_secret_key
# 32-byte secret used for AES-256-GCM encryption of stored tokens (e.g. OneDrive access tokens)
ENCRYPTION_KEY=generate_a_random_32_character_or_longer_secret_key_here
# Comma-separated list of Firebase UIDs authorized for admin endpoints (e.g. /api/automation/run)
ADMIN_UIDS=admin_firebase_uid_1,admin_firebase_uid_2

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Providers
GEMINI_API_KEY=your_gemini_api_key
HF_TOKEN=your_huggingface_token
FLUX_MODEL=black-forest-labs/FLUX.1-Kontext-dev
FLUX_API_URL=https://your-flux-tunnel.trycloudflare.com
CUSTOM_MODEL_URL=http://localhost:8000
ENABLE_FLUX_FALLBACK=false
DAILY_GENERATION_LIMIT=20
# Stable Video Diffusion motion bucket ID (60-100, default: 80)
SVD_MOTION_BUCKET=80

# Identity Likeness Verification Service (FastAPI + InsightFace)
IDENTITY_CHECK_URL=http://localhost:8001
IDENTITY_MIN_SIMILARITY=0.45

# Demo / Local Testing Accounts (Set to true only for local testing with dummy accounts)
ENABLE_DEMO_ACCOUNTS=false

# Microsoft / OneDrive Sync
MS_CLIENT_ID=your_azure_client_id
MS_TENANT_ID=your_azure_tenant_id
MS_CLIENT_SECRET=your_azure_client_secret
MS_REDIRECT_URI=http://localhost:5173/auth/onedrive/callback

# Email Service (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM="Wishes AI <your_email@gmail.com>"

# Optional ISO timestamp to reset monthly usage counts for all users without deleting wish history
USAGE_RESET_AFTER="2026-11-26T09:50:00.000Z"

# Configurable Generation Timeouts (milliseconds) - change here without editing code
VIDEO_GENERATION_TIMEOUT_MS=360000     # 6 minutes (360000 ms) for SVD/Gemini/Colab video generation
IMAGE_GENERATION_TIMEOUT_MS=240000     # 4 minutes (240000 ms) for FLUX/ComfyUI image generation
CLOUDINARY_UPLOAD_TIMEOUT_MS=180000    # 3 minutes (180000 ms) for Cloudinary uploads
COMFY_POLL_INTERVAL_MS=2000            # 2 seconds ComfyUI status polling interval

# Configurable Plan Pricing & Monthly Quotas - change here without editing code
PLAN_CURRENCY="$"
PLAN_FREE_PRICE=0
PLAN_FREE_IMAGES=5
PLAN_FREE_VIDEOS=3
PLAN_PRO_PRICE=5
PLAN_PRO_IMAGES=40
PLAN_PRO_VIDEOS=10
PLAN_ULTIMATE_PRICE=12
PLAN_ULTIMATE_IMAGES=75
PLAN_ULTIMATE_VIDEOS=25

# Automation 1: Excel / OneDrive Event Sync Schedule
EXCEL_SYNC_ENABLED=true
EXCEL_SYNC_CRON="*/15 * * * *"         # Every 15 minutes (e.g. "0 * * * *" for hourly)

# Automation 2: Event Image/Video Generation & Sending Schedule
AUTOMATION_SEND_ENABLED=true
AUTOMATION_SEND_TIME="09:00"           # 24-hour local time (HH:mm) in DEFAULT_TZ to start sending wishes
AUTOMATION_SEND_CHECK_CRON="*/5 * * * *"
DEFAULT_TZ="Asia/Kolkata"
